msgid "فهرستینو"
msgstr "Fehrestino"

msgid "پنل مدیریت فهرست مطالب هوشمند"
msgstr "Smart table of contents management panel"

msgid "نسخه %s"
msgstr "Version %s"

msgid "تنظیمات عمومی"
msgstr "General Settings"

msgid "ظاهر و قالب"
msgstr "Appearance & Theme"

msgid "پیشرفته"
msgstr "Advanced"

msgid "متن عنوان فهرست"
msgstr "Table of Contents Title"

msgid "این متن بالای جعبه‌ی فهرست مطالب نمایش داده می‌شود."
msgstr "This text is displayed above the table of contents box."

msgid "هدینگ‌های نمایش داده‌شده"
msgstr "Displayed Headings"

msgid "حداقل یک سطح باید فعال بماند؛ سلسله‌مراتب به‌صورت خودکار رعایت می‌شود."
msgstr ""
"At least one level must remain enabled; the hierarchy is respected "
"automatically."

msgid "محل نمایش"
msgstr "Placement"

msgid "درج خودکار در محتوا"
msgstr "Auto-insert into content"

msgid "فهرست به‌طور خودکار بالای مطلب درج می‌شود."
msgstr ""
"The table of contents is inserted automatically at the top of the post."

msgid "فعال‌سازی روی برگه‌ها (Pages)"
msgstr "Enable on Pages"

msgid "به‌طور پیش‌فرض فقط روی نوشته‌ها (Posts) فعال است."
msgstr "By default it is only enabled on Posts."

msgid "حداقل تعداد هدینگ برای نمایش فهرست"
msgstr "Minimum number of headings to show the table of contents"

msgid ""
"اگر تعداد هدینگ‌های مطلب کمتر از این عدد باشد، فهرست نمایش داده نمی‌شود."
msgstr ""
"If a post has fewer headings than this number, the table of contents is not "
"displayed."

msgid "درج دستی با شورت‌کد"
msgstr "Manual insertion with shortcode"

msgid ""
"برای جایگذاری فهرست در نقطه‌ی دلخواهی از متن (به‌جای درج خودکار)، این "
"شورت‌کد را در ویرایشگر وارد کنید:"
msgstr ""
"To place the table of contents at a specific point in the text (instead of "
"auto-insert), enter this shortcode in the editor:"

msgid "H2 — عنوان اصلی"
msgstr "H2 — Main heading"

msgid "H3 — زیرعنوان"
msgstr "H3 — Subheading"

msgid "H4 — زیرعنوان جزئی‌تر"
msgstr "H4 — Minor subheading"

msgid "نئو (پیش‌فرض)"
msgstr "Neo (default)"

msgid "طراحی برجسته و پررنگ با حاشیه ضخیم"
msgstr "Bold, prominent design with a thick border"

msgid "مینیمال"
msgstr "Minimal"

msgid "ساده، تمیز و سبک با خط رنگی کنار"
msgstr "Simple, clean and light with a colored side line"

msgid "گرادیانت"
msgstr "Gradient"

msgid "هدر رنگی مدرن با گرادیان جذاب"
msgstr "Modern colored header with an attractive gradient"

msgid "کارتی"
msgstr "Card"

msgid "سایه نرم به سبک کارت‌های مدرن"
msgstr "Soft shadow in the style of modern cards"

msgid "انتخاب قالب فهرست"
msgstr "Choose Table of Contents Theme"

msgid ""
"یکی از قالب‌های آماده را انتخاب کنید — پیش‌نمایش به‌صورت زنده در سمت راست "
"به‌روزرسانی می‌شود."
msgstr "Choose one of the ready-made themes — the preview updates live."

msgid "رنگ اصلی (Accent)"
msgstr "Accent Color"

msgid "این رنگ در حاشیه‌ها، آیکون‌ها و عناصر برجسته‌ی فهرست استفاده می‌شود."
msgstr ""
"This color is used for the borders, icons and highlighted elements of the "
"table of contents."

msgid "شماره‌گذاری خودکار"
msgstr "Automatic numbering"

msgid "نمایش شماره کنار هر آیتم فهرست (مثل ۱، ۱.۱)"
msgstr "Show a number next to each item in the list (e.g. 1, 1.1)"

msgid "وضعیت پیش‌فرض جعبه"
msgstr "Default box state"

msgid "فهرست هنگام بارگذاری صفحه باز یا بسته باشد."
msgstr "Whether the table of contents is open or closed when the page loads."

msgid "باز"
msgstr "Open"

msgid "بسته"
msgstr "Closed"

msgid "اسکرول نرم"
msgstr "Smooth scroll"

msgid "با کلیک روی لینک‌ها، صفحه به‌جای پرش ناگهانی، به‌نرمی اسکرول می‌شود."
msgstr ""
"When a link is clicked, the page scrolls smoothly instead of jumping "
"abruptly."

msgid "هایلایت لینک فعال (Scrollspy)"
msgstr "Active link highlight (Scrollspy)"

msgid "هنگام اسکرول کاربر در مطلب، لینک بخش مربوطه در فهرست برجسته می‌شود."
msgstr ""
"As the reader scrolls through the post, the link of the current section is "
"highlighted in the table of contents."

msgid "درباره عملکرد"
msgstr "About performance"

msgid ""
"✅ فهرست فقط در نوشته‌ها (و در صورت فعال‌سازی، برگه‌ها) بارگذاری می‌شود."
msgstr ""
"✅ The table of contents loads only on posts (and on pages, if enabled)."

msgid "✅ از رندر تکراری فهرست در یک صفحه جلوگیری شده است."
msgstr ""
"✅ Duplicate rendering of the table of contents on a single page is "
"prevented."

msgid "✅ استخراج هدینگ‌ها در برابر اتریبیوت‌های پیچیده مقاوم شده است."
msgstr "✅ Heading extraction is hardened against complex attributes."

msgid "ذخیره تنظیمات"
msgstr "Save Settings"

msgid "پیش‌نمایش زنده"
msgstr "Live Preview"

msgid "زبان پنل و فهرست"
msgstr "Panel and table of contents language"

msgid "حداقل یک سطح هدینگ باید فعال باشد."
msgstr "At least one heading level must be enabled."

msgid "کپی شد ✓"
msgstr "Copied ✓"

msgid "در این مقاله می‌خوانید:"
msgstr "In this article:"

msgid "مقدمه و آشنایی با موضوع"
msgstr "Introduction and overview"

msgid "چرا این موضوع اهمیت دارد؟"
msgstr "Why does this matter?"

msgid "پیش‌نیازهای لازم"
msgstr "Prerequisites"

msgid "بخش اصلی آموزش"
msgstr "Main tutorial section"

msgid "گام اول"
msgstr "Step one"

msgid "جمع‌بندی و نتیجه‌گیری"
msgstr "Summary and conclusion"
